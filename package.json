    "@tanstack/react-virtual": "3.14.7",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@vercel/analytics": "^2.0.1",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "files-sdk": "^2.2.4",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "jotai": "^2.20.2",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "marked": "^18.0.7",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "0.4.6",
    "nuqs": "^2.9.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
