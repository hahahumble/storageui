# Full reference: https://storageui.dev/docs/environment-variables

# NEXT_PUBLIC_APP_URL=https://storageui.dev

# Serve under a sub-path, e.g. "/ui" (default: root).
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_ASSET_PREFIX=

# ─── Login (optional) ────────────────────────────────────────────────────────
# Set both to require sign-in. AUTH_SECRET signs the session cookie (optional).
# AUTH_USERNAME=
# AUTH_PASSWORD=
# AUTH_SECRET=

# ─── Buckets (optional, server-only) ─────────────────────────────────────────
# Number each bucket STORAGE_1_*, STORAGE_2_*, … Others can be added from the UI.

# STORAGE_1_PROVIDER=s3         # s3 | r2 | alibaba | tencent | backblaze-b2 | minio | s3-compatible | webdav
# STORAGE_1_BUCKET=my-bucket
# STORAGE_1_REGION=us-east-1
# STORAGE_1_ACCESS_KEY_ID=
# STORAGE_1_SECRET_ACCESS_KEY=

# WebDAV: ENDPOINT is the collection URL; ROOT scopes it to a subdirectory.
# STORAGE_2_PROVIDER=webdav
# STORAGE_2_ENDPOINT=https://cloud.example.com/remote.php/dav/files/alice
# STORAGE_2_USERNAME=alice
# STORAGE_2_PASSWORD=
# STORAGE_2_ROOT=
